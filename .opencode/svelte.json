{
	"$schema": "https://svelte.dev/opencode/schema.json",
	"mcp": {
		"type": "local",
		"enabled": true
	},
	"subagent": {
		"enabled": true,
		"agents": {
			"svelte-file-editor": {
				"model": "<other-model>",
				"temperature": 1,
				"top_p": 0.7,
				"maxSteps": 20
			}
		}
	},
	"skills": {
		"enabled": ["svelte-core-bestpractices", "svelte-code-writter", "svelte-code-writer"]
	},
	"instructions": {
		"enabled": true
	},
	"autoupdate": true
}
